rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Checks if the user is authenticated and has a verified email
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: Validates Document ID pattern
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper: Shortcut for incoming data
    function incoming() {
      return request.resource.data;
    }

    // Helper: Shortcut for existing data
    function existing() {
      return resource.data;
    }

    // Helper: Validate transaction document structure and content
    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'amount', 'type', 'category', 'date', 'description', 'createdAt', 'updatedAt'])
        && data.keys().size() == 8
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.amount is number && data.amount > 0
        && (data.type == 'income' || data.type == 'expense')
        && data.category is string && data.category.size() <= 64
        && data.date is string && data.date.size() == 10
        && data.description is string && data.description.size() <= 256;
    }

    // Transactions Rules
    match /transactions/{transactionId} {
      // List/Get: Enforce that users can only query/read their own transactions
      allow get: if isSignedIn() && isValidId(transactionId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Create: Enforce authentication, identity integrity, structural validation, and server timestamp
      allow create: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Update: Enforce schema structure, immutable fields, and server timestamp for update
      allow update: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'type', 'category', 'date', 'description', 'updatedAt'])
        );

      // Delete: Users can only delete their own transactions
      allow delete: if isSignedIn() && isValidId(transactionId) && existing().ownerId == request.auth.uid;
    }
  }
}
